# Copiar como .env (local) o ~/app/.env (EC2) y llenar los valores.
# El .env real NO se sube al repositorio.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vehiculos_db
DB_USER=vehiculos_user
DB_PASS=cambiar_por_un_password_seguro
SPRING_PROFILES_ACTIVE=test
DOCKER_HUB_USERNAME=tu_usuario_de_dockerhub
# IP privada o DNS interno de los EC2 de Documentación (G1) y Asignaciones (G2)
DOCUMENTS_SERVICE_URL=http://IP_DOCUMENTACION:PUERTO
ASSIGNMENTS_SERVICE_URL=http://IP_ASIGNACIONES:PUERTO
