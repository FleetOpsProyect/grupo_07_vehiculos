# Copiar como .env (local: junto a docker-compose.yml; EC2: ~/app/.env) y llenar los valores.
# El .env real NO se sube al repositorio.
DB_NAME=vehiculos_db
DB_USER=vehiculos_user
DB_PASS=cambiar_por_un_password_seguro

# Solo producción (EC2). El perfil "test" es el que el dojo llama "ambiente en EC2".
SPRING_PROFILES_ACTIVE=test
DOCKER_HUB_USERNAME=tu_usuario_de_dockerhub
# IP privada o DNS interno de los EC2 de Documentación (G1) y Asignaciones (G2)
DOCUMENTS_SERVICE_URL=http://IP_DOCUMENTACION:PUERTO
ASSIGNMENTS_SERVICE_URL=http://IP_ASIGNACIONES:PUERTO

# Mensajería (HU-13). Local: no hace falta nada, el compose usa LocalStack.
# Producción (EC2): ARN del topic fleetops_vehicle_events y URL de la cola vehicles_queue; el rol del EC2
# necesita sns:Publish sobre el topic y sqs:ReceiveMessage, sqs:DeleteMessage y sqs:GetQueueAttributes
# sobre la cola. Si se dejan vacíos, la API arranca pero no publica ni consume.
AWS_REGION=us-east-1
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
# Para apagar la mensajería en local: FLEETOPS_MESSAGING_ENABLED=false
